<?xml version="1.0" encoding="utf-8"?>


<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/whitecolour"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        tools:context=".signup.presentation.ui.SignupFragment">

        <TextView
            android:id="@+id/textview_title_text_signup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/signup_screen_title_top_margin"
            android:text="@string/registration"
            android:textAppearance="@style/Widget.CashAdvisor.Text.Main_Text"/>

        <app.cashadvisor.customView.authorization.CustomViewSteps
            android:id="@+id/custom_steps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/signup_account_data_between_margin"
            android:layout_marginBottom="@dimen/signup_account_data_between_margin"
            android:gravity="center_horizontal"
            app:currentStep="1"
            app:maxSteps="2"/>

        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/cl_signup_input_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/signup_screen_basic_horizontal_margin"
            android:visibility="visible"
            tools:visibility="visible">

            <TextView
                android:id="@+id/textview_enter_account_data"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/entering_account_data"
                android:textAppearance="@style/Widget.CashAdvisor.Text.RegisterSteps"/>

            <TextView
                android:id="@+id/textview_enter_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/signup_steps_block_data_between_margin"
                android:text="@string/enter_your_email"
                android:textAppearance="@style/Widget.CashAdvisor.Text.Text_cont"
                style="@style/TextView"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/edittext_enter_email"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:hint="@string/example_email"
                android:inputType="textEmailAddress"
                style="@style/Widget.CashAdvisor.TextInputEditText"/>

            <TextView
                android:id="@+id/textview_come_up_with_a_password"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/come_up_with_a_password"
                android:textAppearance="@style/Widget.CashAdvisor.Text.Text_cont"
                style="@style/TextView"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textinputlayout_come_up_with_a_password"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                style="@style/Widget.CashAdvisor.TextInputLayout">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edittext_come_up_with_a_password"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:inputType="textPassword"
                    android:hint="@string/example_password"
                    android:textColorHint="@color/subcolor_2"
                    style="@style/Widget.CashAdvisor.TextInputEditText"/>

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/textview_confirm_the_password"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/confirm_the_password"
                android:textAppearance="@style/Widget.CashAdvisor.Text.Text_cont"
                style="@style/TextView"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textinputlayout_confirm_the_password"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                style="@style/Widget.CashAdvisor.TextInputLayout">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edittext_confirm_the_password"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:inputType="textPassword"
                    android:hint="@string/example_password"
                    android:textColorHint="@color/subcolor_2"
                    style="@style/Widget.CashAdvisor.TextInputEditText"/>

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/textview_allowed_characters_for_the_password"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/allowed_characters_for_the_password"
                android:layout_marginTop="@dimen/signup_edittext_margin"
                android:textAppearance="@style/Widget.CashAdvisor.Text.Subtext"/>

            <Button
                android:id="@+id/btn_create_account"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="@string/create_account"
                android:layout_marginTop="10dp"
                android:textAppearance="@style/Widget.CashAdvisor.Text.Main_Text"
                style="@style/Widget.CashAdvisor.Button.CreateAccountInactive"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cl_signup_confirmation_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/signup_screen_basic_horizontal_margin"
            android:visibility="gone"
            tools:visibility="gone">

            <TextView
                android:id="@+id/confirm_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/confirm"
                android:textAppearance="@style/Widget.CashAdvisor.Text.RegisterSteps"/>

            <TextView
                android:id="@+id/tv_enter_confirmation_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextView"
                android:layout_marginTop="@dimen/signup_steps_block_data_between_margin"
                android:text="@string/enter_confirmation_code"
                android:textAppearance="@style/Widget.CashAdvisor.Text.Text_cont"
                android:textColor="@color/colour1"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/ti_confirmation_code"
                android:layout_width="match_parent"
                android:layout_height="@dimen/signup_height_edittext"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_confirmation_code"
                    style="@style/Widget.CashAdvisor.TextInputEditText"
                    android:inputType="number"
                    android:maxLength="4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/signup_screen_btn_send_again_top_margin">

                <TextView
                    android:id="@+id/tv_send_again"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingVertical="@dimen/signup_padding_text_view_5"
                    android:paddingHorizontal="@dimen/signup_padding_text_view_10"
                    android:text="@string/send_confirmation_code_again"
                    android:textAlignment="center"
                    android:textAppearance="@style/Widget.CashAdvisor.Text.Text_cont"
                    android:textColor="?attr/colour2"/>

                <TextView
                    android:id="@+id/tv_cant_get_code"
                    android:layout_marginStart="@dimen/signup_margin_text_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingVertical="@dimen/signup_padding_text_view_12"
                    android:paddingHorizontal="@dimen/signup_padding_text_view_14"
                    android:text="@string/code_does_not_come"
                    android:textAlignment="center"
                    android:textAppearance="@style/Widget.CashAdvisor.Text.Text_cont"
                    android:textColor="?attr/m3" />

            </LinearLayout>

        </LinearLayout>

        <Button
            android:id="@+id/btn_back"
            android:layout_width="@dimen/signup_width_btn_back"
            android:layout_height="@dimen/signup_height_btn_back"
            android:layout_marginTop="@dimen/signup_btn_back_top_margin"
            android:layout_marginBottom="10dp"
            android:text="@string/back"
            style="@style/Widget.CashAdvisor.Button.SigninButton"/>

    </androidx.appcompat.widget.LinearLayoutCompat>
</ScrollView>
