<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">
    
    <ImageView
        android:id="@+id/ivCategory"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="4dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_gravity="center_vertical"
        android:src="@drawable/ic_bank"
        android:contentDescription="category icon" />

    <LinearLayout
        android:id="@+id/llCategory"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="4dp"
        android:layout_toEndOf="@id/ivCategory">

        <TextView
            android:id="@+id/tvCategoryName"
            style="@style/Widget.CashAdvisor.Text.AnalyticCategoryHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Инвестиции"/>

        <TextView
            android:id="@+id/tvCategoryCurrency"
            style="@style/Widget.CashAdvisor.Text.AnalyticCategoryHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₽"/>

        <TextView
            android:id="@+id/tvCategoryAmount"
            style="@style/Widget.CashAdvisor.Text.AnalyticCategoryHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="15 000,00"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llCategoryDetails"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_below="@+id/llCategory"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="8dp"
        android:layout_toEndOf="@id/ivCategory">

        <include
            layout="@layout/item_analytics_fact_row"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible" />

        <include
            layout="@layout/item_analytics_fact_row"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible" />
    </LinearLayout>
</RelativeLayout>