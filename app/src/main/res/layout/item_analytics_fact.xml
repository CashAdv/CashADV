<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/mp_8dp"
    android:orientation="horizontal">
    
    <ImageView
        android:id="@+id/ivCategory"
        android:layout_width="@dimen/mp_category_icon_size"
        android:layout_height="@dimen/mp_category_icon_size"
        android:padding="@dimen/mp_4dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_gravity="center_vertical"
        android:src="@drawable/ic_bank"
        android:contentDescription="category icon" />

    <LinearLayout
        android:id="@+id/llCategory"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="@dimen/mp_8dp"
        android:layout_marginBottom="@dimen/mp_4dp"
        android:layout_toEndOf="@id/ivCategory">

        <TextView
            android:id="@+id/tvCategoryName"
            style="@style/Widget.CashAdvisor.Text.AnalyticCategoryHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            tools:text="Инвестиции"/>

        <TextView
            android:id="@+id/tvCategoryCurrency"
            style="@style/Widget.CashAdvisor.Text.AnalyticCategoryNumHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mp_plus_currency_symbol"/>

        <TextView
            android:id="@+id/tvCategoryAmount"
            style="@style/Widget.CashAdvisor.Text.AnalyticCategoryNumHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/mp_4dp"
            tools:text="15 000,00"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llCategoryDetails"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_below="@+id/llCategory"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="@dimen/mp_8dp"
        android:layout_toEndOf="@id/ivCategory">
    </LinearLayout>
</RelativeLayout>