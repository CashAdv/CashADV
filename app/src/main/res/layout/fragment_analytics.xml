<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/whitecolour"
    tools:context=".analytics.presentation.ui.AnalyticsFragment">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/playerLeftGuideLine"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="36dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/playerRightGuideLine"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_end="36dp" />

    <app.cashadvisor.customView.ProfileHeaderMain
        android:id="@+id/profile_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/header_margin_horizontal"
        android:layout_marginTop="@dimen/header_margin_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <HorizontalScrollView
        android:id="@+id/svMainBarAnalytics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:scrollIndicators="none"
        android:scrollbars="none"
        android:paddingHorizontal="8dp"
        app:layout_constraintTop_toBottomOf="@id/profile_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.chip.ChipGroup
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/btnIncome"
                style="@style/Widget.CashAdvisor.Button.AnalyticButton"
                android:layout_width="wrap_content"
                android:layout_marginStart="12dp"
                android:checked="true"
                android:text="@string/mp_income_analytics"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/btnExpense"
                style="@style/Widget.CashAdvisor.Button.AnalyticButton"
                android:layout_width="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/mp_expense_analytics"/>

            <com.google.android.material.chip.Chip
                android:id="@+id/btnSaving"
                style="@style/Widget.CashAdvisor.Button.AnalyticButton"
                android:layout_width="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/mp_saving_analytics"/>
        </com.google.android.material.chip.ChipGroup>

    </HorizontalScrollView>

    <TextView
        android:id="@+id/tvAnalyticAmount"
        style="@style/Widget.CashAdvisor.Text.AnalyticAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="24dp"
        android:gravity="center_horizontal"
        android:paddingVertical="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/svMainBarAnalytics"
        android:text="@string/mp_zero_balance_amount"/>

    <TextView
        android:id="@+id/tvAnalyticAmountCurrency"
        style="@style/Widget.CashAdvisor.Text.AnalyticAmountCurrency"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@id/tvAnalyticAmount"
        app:layout_constraintTop_toTopOf="@id/tvAnalyticAmount"
        android:text="₽"/>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/cgFilter"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:layout_marginTop="24dp"
        app:chipSpacingHorizontal="24dp"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:layout_constraintTop_toBottomOf="@id/tvAnalyticAmount"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.chip.Chip
            android:id="@+id/btnFactFilter"
            style="@style/Widget.CashAdvisor.Button.AnalyticFilterButton"
            android:layout_width="wrap_content"
            android:checked="true"
            android:text="@string/mp_fact_filter"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/btnPlanFilter"
            style="@style/Widget.CashAdvisor.Button.AnalyticFilterButton"
            android:layout_width="wrap_content"
            android:text="@string/mp_plan_filter"/>
    </com.google.android.material.chip.ChipGroup>

    <TextView
        android:id="@+id/tvAnalyticInfoHeader"
        style="@style/Widget.CashAdvisor.Text.AnalyticInfoHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"

        app:layout_constraintTop_toBottomOf="@id/cgFilter"
        app:layout_constraintStart_toStartOf="@id/playerLeftGuideLine"
        android:text="@string/mp_fact_analytic_info_header"/>

    <FrameLayout
        android:id="@+id/flAnalyticInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/tvAnalyticInfoHeader"
        app:layout_constraintStart_toStartOf="@id/playerLeftGuideLine"
        app:layout_constraintEnd_toEndOf="@id/playerRightGuideLine">

        <TextView
            android:id="@+id/tvAnalyticInfoPlaceHolder"
            style="@style/Widget.CashAdvisor.Text.Subtext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"

            android:text="@string/mp_fact_income_analytic_info_zero"
            android:gravity="center_horizontal"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAnalyticInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            tools:listitem="@layout/item_analytics_fact"
            tools:itemCount="2"
            android:visibility="visible"/>
    </FrameLayout>

    <Button
        android:id="@+id/btn_add_bank"
        style="@style/Widget.CashAdvisor.Button.Colour2FilledButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toStartOf="@+id/btn_add_manually"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/btn_add_manually"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/flAnalyticInfo"
        android:text="@string/mp_add_bank_button"
        android:visibility="visible"/>

    <Button
        android:id="@+id/btn_add_manually"
        style="@style/Widget.CashAdvisor.Button.Bg2FilledButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mp_add_fact_manually_button"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/btn_add_bank"
        app:layout_constraintTop_toTopOf="@id/btn_add_bank"/>
</androidx.constraintlayout.widget.ConstraintLayout>