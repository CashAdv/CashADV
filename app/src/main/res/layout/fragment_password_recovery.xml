<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/whitecolour"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    tools:context=".authorization.presentation.ui.PasswordRecoveryFragment">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/recoveryPassword"
        android:textAppearance="@style/Widget.CashAdvisor.Text.Main_Text" />

    <app.cashadvisor.customView.authorization.CustomViewSteps
        android:id="@+id/custom_steps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_horizontal"
        app:currentStep="1"
        app:maxSteps="3" />

    <TextView
        android:id="@+id/tv_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/login_screen_step_top_margin"
        android:text="@string/enter_account_data"
        android:textAppearance="@style/Widget.CashAdvisor.Text.Subtext"
        android:textColor="@color/colour1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/custom_steps" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_email_forms"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="38dp"
        android:layout_marginTop="30dp"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/tv_subtitle">

        <TextView
            android:id="@+id/tv_enter_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/login_screen_edit_text_top_margin"
            android:text="@string/enter_email_acc"
            android:textAppearance="@style/Widget.CashAdvisor.Text.Text_cont"
            android:textColor="@color/colour1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/ti_email_input"
            style="@style/TextInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/login_screen_edit_text_top_margin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_enter_email">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_email_input"
                style="@style/EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/email_example" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btn_get_code"
            style="@style/Widget.CashAdvisor.Button.SigninButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/login_screen_btn_height"
            android:layout_marginTop="@dimen/login_screen_edit_text_top_margin"
            android:text="@string/get_the_code"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ti_email_input" />

        <TextView
            android:id="@+id/tv_recovery_instructions"
            style="@style/Widget.CashAdvisor.Text.RecoveryDisclaimerText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/recovery_instructions"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_get_code">

        </TextView>


    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_confirmation_code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/login_screen_basic_horizontal_margin"
        android:layout_marginTop="30dp"
        android:visibility="gone"
        tools:visibility="gone">

        <TextView
            android:id="@+id/tv_enter_confirmation_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/login_screen_edit_text_top_margin"
            android:text="@string/enter_confirmation_code"
            android:textAppearance="@style/Widget.CashAdvisor.Text.Text_cont"
            android:textColor="@color/colour1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/ti_confirmation_code"
            style="@style/TextInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/login_screen_edit_text_top_margin"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_enter_confirmation_code">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_confirmation_code"
                style="@style/EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="4" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tv_send_again"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/login_screen_btn_send_again_top_margin"
            android:paddingVertical="@dimen/login_screen_text_input_vertical_padding"
            android:text="@string/send_confirmation_code_again_seconds"
            android:textAlignment="center"
            android:textAppearance="@style/Widget.CashAdvisor.Text.Text_cont"
            android:textColor="@color/subcolor_2"
            app:layout_constraintEnd_toStartOf="@+id/tv_cant_get_code"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ti_confirmation_code" />

        <TextView
            android:id="@+id/tv_cant_get_code"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/login_screen_text_input_vertical_padding"
            android:text="@string/code_does_not_come"
            android:textAlignment="center"
            android:textAppearance="@style/Widget.CashAdvisor.Text.Text_cont"
            android:textColor="?attr/m3"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/tv_send_again"
            app:layout_constraintTop_toTopOf="@id/tv_send_again" />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_new_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/login_screen_basic_horizontal_margin"
        android:layout_marginTop="30dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_come_up_with_a_password"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/login_screen_edit_text_top_margin"
            android:text="@string/come_up_with_a_password"
            android:textAppearance="@style/Widget.CashAdvisor.Text.Text_cont"
            android:textColor="@color/colour1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/ti_password_input"
            style="@style/TextInputLayout.PasswordField"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/login_screen_edit_text_top_margin"
            app:helperTextTextAppearance="@style/Widget.CashAdvisor.Text.Subtext"
            app:helperTextTextColor="@color/subcolor_2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_come_up_with_a_password">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_password_input"
                style="@style/EditText.PasswordField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tv_new_password_instructions"
            style="@style/Widget.CashAdvisor.Text.DisclaimerText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/new_password_instruction"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ti_password_input">

        </TextView>

        <Button
            android:id="@+id/btn_send_new_password"
            style="@style/Widget.CashAdvisor.Button.SigninButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/login_screen_btn_height"
            android:layout_marginTop="@dimen/login_screen_edit_text_top_margin"
            android:text="@string/get_the_code"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_new_password_instructions" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <Button
        android:id="@+id/btn_back"
        style="@style/Widget.CashAdvisor.Button.SigninButton"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/login_screen_btn_height"
        android:layout_marginTop="@dimen/login_screen_btn_height"
        android:paddingHorizontal="@dimen/login_screen_back_btn_horizontal_padding"
        android:text="@string/back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_email_forms" />


</androidx.appcompat.widget.LinearLayoutCompat>

